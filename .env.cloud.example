# Configure only in Vercel Environment Variables; never use a VITE_ prefix.
# Session pooler URL from Supabase > Connect. NOT the public project URL or anon key.
CATARSE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
CATARSE_PUBLIC_ORIGIN=https://YOUR-PROJECT.vercel.app
# Random secret of at least 32 characters; needed once to create the owner account.
CATARSE_SETUP_KEY=
CATARSE_GEMINI_ENABLED=true
GEMINI_API_KEY=
CATARSE_GEMINI_MODEL=gemini-3.8-flash
CATARSE_GEMINI_DAILY_LIMIT=20
